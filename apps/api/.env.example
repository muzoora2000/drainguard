# ---------------------------------------------------------------------------
# DrainGuard API - copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. Use the Neon pooled connection string at runtime and the direct
# (unpooled) connection string for migrations. Locally both can be identical.
DATABASE_URL="postgresql://drainguard:drainguard@localhost:5432/drainguard?schema=public"
DIRECT_URL="postgresql://drainguard:drainguard@localhost:5432/drainguard?schema=public"

# Used only by prisma/seed.ts. Required when seeding production.
SEED_PASSWORD=replace-with-a-strong-demo-password

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# JWT. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-character-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# SMS provider: mock | africastalking | twilio
SMS_PROVIDER=mock
SMS_MAX_ATTEMPTS=3
SMS_RETRY_BASE_MINUTES=2
# Used only when no assigned contact exists or all primary deliveries fail.
SMS_FALLBACK_PHONE=+254700000000

# Africa's Talking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Reading acceptance window (reliability: delayed / out-of-order readings)
INGEST_MAX_PAST_DAYS=7
INGEST_MAX_FUTURE_MINUTES=10
# GPS / payload guard rails
MAX_READING_BODY_BYTES=262144

# Background jobs (standard 5-field cron; server timezone is UTC)
OFFLINE_JOB_CRON=* * * * *
RULE_SWEEP_CRON=* * * * *
NOTIFICATION_RETRY_CRON=* * * * *
ESCALATION_CRON=* * * * *
JOBS_ENABLED=true

# Public base URL used in logs/demo links only (no links are sent by SMS).
PUBLIC_API_URL=http://localhost:4000
